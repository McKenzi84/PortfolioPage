---
// Removed Button import to create a custom non-animated button
import { t } from "../../utils/i18n";
import { Image } from "astro:assets";
import profileImg from "../../assets/profile.png";

const lang = Astro.currentLocale;
---

<section
  id="start"
  class="relative overflow-hidden pt-28 pb-16 md:pt-36 md:pb-24"
>
  <!-- SVG BACKGROUND -->
  <div class="absolute inset-0 -z-20 pointer-events-none">
    <svg
      class="w-full h-full"
      viewBox="0 0 1440 900"
      preserveAspectRatio="xMidYMid slice"
      xmlns="http://www.w3.org/2000/svg"
    >
      <defs>
        <linearGradient id="gridFade" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="currentColor" stop-opacity="0.08"
          ></stop>
          <stop offset="100%" stop-color="currentColor" stop-opacity="0.02"
          ></stop>
        </linearGradient>
      </defs>

      <!-- Diagonal technical lines -->
      <g stroke="url(#gridFade)" stroke-width="1">
        <path d="M0 200 L1440 0"></path>
        <path d="M0 350 L1440 150"></path>
        <path d="M0 500 L1440 300"></path>
        <path d="M0 650 L1440 450"></path>
        <path d="M0 800 L1440 600"></path>
      </g>

      <!-- Subtle circles (data / precision feel) -->
      <g fill="none" stroke="url(#gridFade)" stroke-width="1">
        <circle cx="1100" cy="250" r="180"></circle>
        <circle cx="1100" cy="250" r="260"></circle>
        <circle cx="300" cy="700" r="140"></circle>
      </g>
    </svg>
  </div>

  <!-- Soft gradient glow -->
  <div
    class="absolute -top-40 -left-40 w-[600px] h-[600px] bg-primary/10 rounded-full blur-3xl -z-10"
  >
  </div>

  <div
    class="max-w-container mx-auto px-6 grid grid-cols-1 md:grid-cols-12 gap-gutter relative z-10"
  >
    <div class="md:col-span-7 flex flex-col justify-center">
      <span class="font-mono text-primary text-sm mb-4"
        >{t("hero.greeting", lang)}</span
      >

      <h1 class="font-heading text-h1 text-secondary dark:text-white mb-4">
        {t("hero.name", lang)}
      </h1>

      <p
        class="text-lg md:text-xl text-secondary/80 dark:text-white/80 mb-6 max-w-2xl"
      >
        {t("hero.pitch", lang)}
      </p>

      <p class="text-secondary/70 dark:text-white/70 mb-8">
        {t("hero.role", lang)}
      </p>

      <div class="flex mt-8">
        <a
          href="#about"
          class="inline-flex items-center justify-center rounded-lg font-medium text-base py-2 px-6 border border-primary text-primary hover:bg-primary/10 bg-transparent"
        >
          {t("hero.ctaAbout", lang)}
        </a>
      </div>
    </div>

    <div class="md:col-span-5 mt-12 md:mt-0">
      <div class="relative">
        <div
          class="absolute -top-6 -right-6 w-64 h-64 md:w-80 md:h-80 bg-gradient-to-br from-primary/10 to-orange-400/10 rounded-3xl -z-10"
        >
        </div>

        <Image
          src={profileImg}
          alt="Nicremo - Portfolio"
          class="w-full max-w-md mx-auto rounded-2xl shadow-lg"
          width="500"
          height="600"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </div>

  <!-- Scroll Down Indicator -->
  <div
    id="scroll-indicator"
    class="absolute bottom-8 left-1/2 -translate-x-1/2 opacity-100 animate-bounce cursor-pointer z-20"
    onclick="document.getElementById('about')?.scrollIntoView({ behavior: 'smooth' });"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="28"
      height="28"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="text-primary dark:text-highlightBlue"
    >
      <path d="M12 5v14"></path>
      <path d="m19 12-7 7-7-7"></path>
    </svg>
  </div>
</section>

<style>
  /* Ensure the section is relative for absolute positioning of the indicator */
  section#start {
    position: relative;
    min-height: 100vh; /* Ensure hero takes full viewport height to make scroll indicator meaningful */
  }
</style>

<!-- Removed GSAP animation script as requested -->
